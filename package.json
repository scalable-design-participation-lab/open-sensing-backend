  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "~1.10.0",
    "@google-cloud/functions-framework": "^5.0.5",
    "@google-cloud/logging-winston": "~6.0.2",
    "@google-cloud/secret-manager": "~6.3.0",
    "express": "^4.22.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "pug": "^3.0.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "c8": "^8.0.0",
    "mocha": "^10.0.0",
    "supertest": "^6.0.0"
  }
}
